# ── 어디에도 올리지 않는다 ─────────────────────────────
# 정답 · 확인 도구
tools/
# 스크립트를 돌리면 다시 나오는 결과
정리본/
# 진단 기록
진단/
# 그 밖의 csv · xlsx — data/ 의 예시 파일만 올린다
*.csv
*.xlsx
!data/*.csv
!data/*.xlsx

# ── 저장소에 올리는 것의 목록에 없다 ───────────────────
# 정리/ 는 정리 스크립트(코드)만
정리/*
!정리/*.py
# Claude Code 설정 · 스킬
.claude/

# ── 배포 · 실행 부산물 ────────────────────────────────
.vercel/
node_modules/
__pycache__/
.env
.env.*
